# Copie este arquivo para .env e preencha com suas chaves reais
# cp .env.example .env

# Chave da API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Chave da API Serper (https://serper.dev)
SERPER_API_KEY=sua_chave_serper_aqui

# Modelo free na OpenRouter ($0/token). Sufixo :free é obrigatório no tier gratuito.
# Router automático: openrouter/free
# Lista atual: https://openrouter.ai/models (filtro price = 0)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Ajustes para plano gratuito OpenRouter (opcional)
# OPENROUTER_MAX_TOKENS=2048
# OPENROUTER_PAUSE_ENTRE_AGENTES=3
# OPENROUTER_RATE_LIMIT_RETRIES=4
# OPENROUTER_RATE_LIMIT_ESPERA_BASE=10

# Pastas (opcional — os valores padrão funcionam na maioria dos casos)
# KNOWLEDGE_BASE_DIR=./knowledge_base
# CHROMA_PERSIST_DIR=./data/chroma

# Modelo de embeddings local (opcional)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
