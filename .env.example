# Copie este arquivo para .env e preencha com suas chaves reais
# cp .env.example .env

# Provedor LLM: opencode_go (padrão) | openrouter
LLM_PROVIDER=opencode_go

# --- OpenCode Go + DeepSeek V4 Flash (padrão para gerar os relatórios) ---
# Chave: https://opencode.ai (Workspace → Go / API Keys)
OPENCODE_GO_API_KEY=sua_chave_opencode_go_aqui
OPENCODE_GO_MODEL=deepseek-v4-flash
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# DeepSeek V4 Flash no Go pode exigir opt-in "Enable models hosted in China"
# no painel do OpenCode (Workspace → Go).

# --- OpenRouter (opcional / legado) ---
# OPENROUTER_API_KEY=sua_chave_openrouter_aqui
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Chave da API Serper (https://serper.dev) — busca web em casos de processo/segurança
SERPER_API_KEY=sua_chave_serper_aqui

# Ajustes opcionais de ritmo / tokens
# LLM_MAX_TOKENS=2048
# LLM_PAUSE_ENTRE_AGENTES=1
# LLM_RATE_LIMIT_RETRIES=4
# LLM_RATE_LIMIT_ESPERA_BASE=10

# Pastas (opcional — os valores padrão funcionam na maioria dos casos)
# KNOWLEDGE_BASE_DIR=./knowledge_base
# CHROMA_PERSIST_DIR=./data/chroma

# Modelo de embeddings local (opcional)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
