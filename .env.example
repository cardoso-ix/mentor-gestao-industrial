# Copie este arquivo para .env e preencha com suas chaves reais
# cp .env.example .env

# Provedor LLM exclusivo: OpenCode Go
LLM_PROVIDER=opencode_go

# --- OpenCode Go + DeepSeek V4.1 Flash (padrão de alta velocidade e precisão) ---
# Obtenha sua chave em: https://opencode.ai (Workspace → Go / API Keys)
OPENCODE_GO_API_KEY=sua_chave_opencode_go_aqui
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Modelos recomendados disponíveis na assinatura do OpenCode Go:
# - deepseek-v4.1-flash (padrão)
# - deepseek-chat
# - deepseek-reasoner
# - qwen2.5-coder-32b-instruct

# Importante: No painel do OpenCode (Workspace → Go), certifique-se de ativar
# "Enable models hosted in China" para acesso direto aos modelos DeepSeek.

# Chave da API Serper (https://serper.dev) — busca web em casos de processo/segurança
SERPER_API_KEY=sua_chave_serper_aqui

# Ajustes opcionais de ritmo / tokens
# LLM_MAX_TOKENS=2048
# LLM_PAUSE_ENTRE_AGENTES=1
# LLM_RATE_LIMIT_RETRIES=4
# LLM_RATE_LIMIT_ESPERA_BASE=10

# Pastas da base de conhecimento (opcional)
# KNOWLEDGE_BASE_DIR=./knowledge_base
# CHROMA_PERSIST_DIR=./data/chroma

# Modelo de embeddings local (opcional)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
